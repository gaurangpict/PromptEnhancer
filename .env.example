# Copy this file to .env and fill in your key.
# Free key, no credit card: https://build.nvidia.com → sign in → "Get API Key"
NVIDIA_API_KEY=nvapi-...

# Optional overrides (defaults shown). Check current model names on build.nvidia.com.
# QUESTION_MODEL=meta/llama-3.3-70b-instruct
# JUDGE_MODEL=meta/llama-3.1-405b-instruct   # evals only

# Question selection (see docs/question-design.md)
# MAX_QUESTIONS=5
# ASK_MIN_IMPACT=3
# ASK_MAX_CONFIDENCE=3
# IGNORE_MAX_IMPACT=1
